# Copy this file to .env and fill in a free Supabase project's values.
# Project Settings -> API in the Supabase dashboard.
#
# Without these values, `npm run dev` falls back to the same-browser
# BroadcastChannel transport so two tabs can test the lobby on one machine.
# Production builds require them.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
